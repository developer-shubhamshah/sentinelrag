# ─── SentinelRAG environment ───────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in. Never commit real keys.

# Postgres (matches docker-compose.yml; host 5432 is often taken by a local
# Postgres install, so the container publishes on 5433)
DATABASE_URL=postgresql://postgres:dev@localhost:5433/sentinel

# Claude — generation + LLM-as-a-judge ONLY (no embeddings).
# Model IDs verified against docs.claude.com; keep them here, never inline.
ANTHROPIC_API_KEY=sk-ant-...
GEN_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-haiku-5-5
ROUTER_MODEL=claude-haiku-5-5

# Embeddings — pick ONE provider. Default: OpenAI text-embedding-3-small (1536-dim).
EMBED_PROVIDER=openai
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small
# EMBED_DIM is derived from the model in src/config.ts; do not set it here.

# Voyage alternative (leave blank unless EMBED_PROVIDER=voyage)
# VOYAGE_API_KEY=

# Ingestion
# Optional NVD API key — raises rate limit from 5 to 50 req / 30s (sent as apiKey header)
# NVD_API_KEY=
CVE_YEAR=2024

# Optional reranker (stretch goal)
# COHERE_API_KEY=
