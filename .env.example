# ─── SentinelRAG environment ───────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in your own values. NEVER commit real keys.
#
# Conventions below:
#   KEY=            → fill this in your local .env (blank here on purpose).
#   # KEY=value     → optional; falls back to the default in src/config.ts.
# NOTE: leave the commented keys commented. Setting e.g. `GEN_MODEL=` (empty)
# overrides the code default with an empty string, which is NOT what you want —
# Zod's .default() only applies when the variable is absent.

# ─── Database (required) ─────────────────────────────────────────────────────
# Local Docker Postgres from docker-compose.yml (not a secret). The container
# publishes on 5433 so it won't clash with a host Postgres on 5432.
DATABASE_URL=postgresql://postgres:dev@localhost:5433/sentinel

# ─── Claude — generation + LLM-as-a-judge ONLY (never embeddings) ────────────
ANTHROPIC_API_KEY=
# Model IDs (verified against docs.claude.com). Defaults live in src/config.ts:
# GEN_MODEL=claude-opus-5-5
# JUDGE_MODEL=claude-haiku-5-5
# ROUTER_MODEL=claude-haiku-5-5

# ─── Embeddings — pick ONE provider ──────────────────────────────────────────
# Default provider/model (OpenAI text-embedding-3-small, 1536-dim) set in src/config.ts:
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# Voyage alternative — set EMBED_PROVIDER=voyage and EMBED_MODEL=voyage-3, then:
VOYAGE_API_KEY=

# ─── Ingestion ───────────────────────────────────────────────────────────────
# Optional NVD API key — raises the rate limit from 5 to 50 req / 30s.
NVD_API_KEY=
# CVE_YEAR=2024

# ─── Optional reranker (stretch goal) ────────────────────────────────────────
COHERE_API_KEY=

# ─── HTTP hardening (§9) ──────────────────────────────────────────────────────
# Rate limits (cost/abuse control for LLM calls). Window accepts "1 minute" or ms.
# Defaults live in src/config.ts — leave commented to use them (empty would be
# coerced to 0 and fail validation).
# RATE_LIMIT_MAX=60            # per-IP requests per window
# RATE_LIMIT_GLOBAL_MAX=600    # all clients combined per window
# RATE_LIMIT_WINDOW=1 minute
# CORS allowed origins, comma-separated (e.g. https://app.example.com).
# Empty = no frontend yet, cross-origin disabled (documented N/A in SECURITY.md).
CORS_ORIGINS=
