{
  "name": "sentinelrag",
  "version": "0.1.0",
  "private": true,
  "description": "Security-domain query router + eval harness: deterministic -> direct LLM -> RAG -> agentic, with cited, groundedness-checked answers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:migrate": "tsx src/migrate.ts",
    "ingest": "tsx src/ingest/run.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "eval": "tsx eval/run.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "openai": "^7.55.0",
    "pg": "^8.23.1",
    "pgvector": "^0.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
